# DevPulse environment variables.
#
# Demo mode needs NONE of these: `npm run dev` works with this file absent.
# Live mode (real GitHub data) needs every variable below. Copy this file to `.env`
# (which is git-ignored) and fill in the values. Never commit real secrets.

# PostgreSQL connection string (users, sessions, selected repositories).
# Matches the docker-compose.yml shipped with the repo.
DATABASE_URL="postgresql://devpulse:devpulse@localhost:5432/devpulse"

# Secret used to sign sessions and encrypt stored OAuth tokens. At least 32 characters.
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public base URL of this app (no trailing slash). Must match the callback URL you
# register with GitHub: <BETTER_AUTH_URL>/api/auth/callback/github
BETTER_AUTH_URL="http://localhost:3000"

# Credentials of your GitHub OAuth App (or GitHub App). See README → "GitHub OAuth setup".
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
